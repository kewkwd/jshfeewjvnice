# Einstellungen für den Server-Betrieb. Kopieren nach "server.env" und dort ausfüllen.
# server.env enthält Geheimnisse: nie weitergeben, nie ins Internet stellen.
# Zeilen mit # sind Kommentare; leere Werte einfach weglassen oder auskommentiert lassen.

# Browser unsichtbar (auf dem Server gibt es kein Fenster). Nicht ändern.
SS_HEADLESS=true

# Wie oft Protokolle ausführlich sind: INFO (normal) oder DEBUG (zur Fehlersuche).
SS_LOG_LEVEL=INFO

# Maximale Anzahl Kommentare je Video (0 = nur Videodaten).
# SS_MAX_COMMENTS=500

# Proxy gegen gesperrte Server-Adressen (TikTok/Instagram sperren Rechenzentren häufig; Reddit sperrt manche Adressen ganz).
# Mehrere mit Komma trennen. Beispiel (Platzhalter, keine echten Daten):
# SS_PROXIES=http://BENUTZER:PASSWORT@proxy.beispiel.de:8000

# Anmeldung nur mit gültiger Sitzung verlangen (Lauf bricht ab, statt anonym zu laufen).
# SS_REQUIRE_AUTH=false

# Datenbank und Browserprofile liegen standardmäßig im Volume /data (bitte so lassen).
# SS_DB_PATH=data/scrape.db
